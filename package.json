    "@typescript-eslint/parser": "^7.16.0",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.10.1",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "postcss": "^8.4.49",
    "prisma": "^6.15.0",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
