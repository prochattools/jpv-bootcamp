    "next": "^16.2.6",
    "next-themes": "^0.4.4",
    "nextjs-toploader": "^1.6.11",
    "payload": "3.85.1",
    "pg": "^8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.4.1",
    "resend": "^4.0.0",
    "sass": "^1.82.0",
    "server-only": "0.0.1",
    "sharp": "^0.33.0",
    "stripe": "^16.0.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "yup": "^1.4.0"
