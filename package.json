{
  "name": "jpv-bootcamp",
  "version": "1.0.6",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "scripts": {
    "predev": "node scripts/dev/predev.js",
    "dev": "next dev",
    "build": "prisma generate --schema=prisma/system.prisma && next build",
    "generate:importmap": "payload generate:importmap",
    "type-check:payload": "tsc --noEmit --pretty false",
    "preview:readiness:check": "tsx scripts/preview/readiness-config.mts",
    "preview:release:manifest": "tsx scripts/preview/release-manifest.mts",
    "preview:release:preflight": "tsx scripts/preview/release-preflight.mts",
    "preview:smoke:plan": "tsx scripts/preview/smoke-check.mts",
    "preview:rollback:plan": "tsx scripts/preview/rollback-plan.mts",
    "preview:release:packet": "tsx scripts/preview/release-packet.mts",
    "preview:staging:candidate-report": "tsx scripts/preview/release-packet.mts --mode=candidate-report",
    "test:preview-readiness": "tsx scripts/preview_readiness_config.test.ts && tsx scripts/preview_startup_mode.test.ts",
    "evidence:create": "tsx scripts/create_staging_evidence_artifacts.ts",
    "evidence:validate": "tsx scripts/validate_staging_evidence_artifacts.ts",
    "evidence:test": "tsx scripts/evidence_artifact_automation.test.ts && tsx scripts/evidence_package_scripts.test.ts",
    "toolchain:check": "tsx scripts/toolchain_preflight.ts",
  "staging:static-preflight": "pnpm toolchain:check && git diff --check && ./node_modules/.bin/tsc --noEmit --pretty false --incremental false && ./node_modules/.bin/prisma validate --schema=prisma/system.prisma && ./node_modules/.bin/prisma validate --schema=prisma/schema.prisma && ./node_modules/.bin/tsx scripts/evidence_artifact_automation.test.ts && ./node_modules/.bin/tsx scripts/evidence_package_scripts.test.ts && ./node_modules/.bin/tsx scripts/committed_evidence_guard.test.ts && ./node_modules/.bin/tsx scripts/status_docs_consistency.test.ts && ./node_modules/.bin/tsx scripts/v34_go_live_plan_static.test.ts && ./node_modules/.bin/tsx scripts/preview_migration_inventory.test.ts && ./node_modules/.bin/tsx scripts/migration_readiness_static.test.ts && ./node_modules/.bin/tsx scripts/migration_rehearsal_safety.test.ts && ./node_modules/.bin/tsx scripts/staging_evidence_static.test.ts && ./node_modules/.bin/tsx scripts/operator_handoff_static.test.ts && ./node_modules/.bin/tsx scripts/billing_readiness_report.test.ts && ./node_modules/.bin/tsx scripts/member_checkout.test.ts && pnpm evidence:validate",
    "payload:branding:check": "pnpm generate:importmap && pnpm type-check:payload",
    "payload:staging:migrate:status": "tsx scripts/payload/run-staging-migrations.mts --status",
    "payload:staging:migrate": "tsx scripts/payload/run-staging-migrations.mts --apply",
    "test:payload-member-auth": "tsx scripts/payload_member_auth_flow.test.ts",
    "test:payload-admin-branding": "tsx scripts/payload_admin_branding.test.ts",
    "test:payload-preferences-migration": "tsx scripts/payload_preferences_constraint_migration.test.ts",
    "test:payload-staging-boundary": "tsx scripts/payload_staging_migration_boundary.test.ts",
    "start": "scripts/runtime/start-prod.sh",
    "start:app": "next start",
    "postinstall": "prisma generate --schema=prisma/system.prisma",
    "lint": "next lint",
    "migrate-db": "prisma migrate dev --name init",
    "db:init": "node scripts/db/init-tenant.js",
    "db:cleanup": "node scripts/db/cleanup-tenant.js",
    "db:cleanup:public": "node scripts/db/cleanup-public-runtime.js",
    "db:migrate:dev": "prisma migrate deploy --schema=prisma/system.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema=prisma/system.prisma",
    "db:dedupe:check": "tsx scripts/db/test_customer_provisioning_dedupe.ts",
    "test:payload-course": "tsx scripts/payload_entitlement_evaluator.test.ts && tsx scripts/payload_course_access_service.test.ts && tsx scripts/payload_course_admin_services.test.ts && tsx scripts/payload_course_reconciliation.test.ts && tsx scripts/payload_course_stripe_shadow_sync.test.ts && tsx scripts/payload_course_email_sender.test.ts && tsx scripts/payload_member_portal.test.ts && tsx scripts/payload_member_billing_overview.test.ts && tsx scripts/payload_member_billing_portal.test.ts && tsx scripts/payload_member_announcements.test.ts && tsx scripts/payload_member_profile_update.test.ts && tsx scripts/payload_member_invitation.test.ts && tsx scripts/payload_member_security_controls.test.ts && tsx scripts/payload_community_portal.test.ts && tsx scripts/payload_space_memberships.test.ts && tsx scripts/payload_community_posting.test.ts && tsx scripts/payload_community_files.test.ts && tsx scripts/payload_community_file_delivery.test.ts && tsx scripts/payload_community_discussion.test.ts && tsx scripts/payload_lesson_resource_delivery.test.ts",
    "test:payload-community-files": "tsx scripts/payload_community_files.test.ts",
    "test:payload-community-file-delivery": "tsx scripts/payload_community_file_delivery.test.ts",
    "test:payload-community-discussion": "tsx scripts/payload_community_discussion.test.ts",
    "test:payload-community-moderation": "tsx scripts/payload_community_moderation.test.ts",
    "test:payload-community-posting": "tsx scripts/payload_community_posting.test.ts",
    "test:payload-community-portal": "tsx scripts/payload_community_portal.test.ts",
    "test:payload-member-announcements": "tsx scripts/payload_member_announcements.test.ts",
    "test:payload-member-billing": "tsx scripts/payload_member_billing_overview.test.ts",
    "test:payload-member-billing-portal": "tsx scripts/payload_member_billing_portal.test.ts",
    "test:payload-identity": "tsx scripts/payload_identity_destination.test.ts",
    "payload:course:seed": "tsx scripts/payload/seed-course-admin-data.mts",
    "payload:course:reconcile": "tsx scripts/payload/reconcile-entitlements.mts",
    "payload:email:send": "tsx scripts/payload/send-queued-emails.mts",
    "stripe:check-products": "tsx scripts/stripe/check_price_products.ts",
    "mcp:discover": "tsx scripts/mcp-discover.ts",
    "mcp:provision": "tsx scripts/mcp-provision-tenant.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@payloadcms/db-postgres": "3.85.1",
    "@payloadcms/next": "3.85.1",
    "@payloadcms/richtext-lexical": "3.85.1",
    "@payloadcms/ui": "3.85.1",
    "@prisma/client": "^6.15.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
