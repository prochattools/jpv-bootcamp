{
	"name": "boilerplate-landing-page",
	"version": "1.0.0",
	"private": true,
	"prisma": {
		"schema": "prisma/system.prisma"
	},
	"scripts": {
		"predev": "node scripts/dev/predev.js",
		"dev": "next dev",
		"build": "npx prisma generate --schema=prisma/system.prisma && next build",
		"start": "scripts/runtime/start-prod.sh",
		"start:app": "next start",
		"postinstall": "npx prisma generate --schema=prisma/system.prisma",
		"lint": "next lint",
		"migrate-db": "npx prisma migrate dev --name init",
		"db:init": "node scripts/db/init-tenant.js",
		"db:cleanup": "node scripts/db/cleanup-tenant.js",
		"db:cleanup:public": "node scripts/db/cleanup-public-runtime.js",
		"db:migrate:dev": "npx prisma migrate deploy --schema=prisma/system.prisma",
		"db:migrate:prod": "npx prisma migrate deploy --schema=prisma/system.prisma",
		"db:dedupe:check": "tsx scripts/db/test_customer_provisioning_dedupe.ts",
		"stripe:check-products": "tsx scripts/stripe/check_price_products.ts",
		"mcp:discover": "tsx scripts/mcp-discover.ts",
		"mcp:provision": "tsx scripts/mcp-provision-tenant.ts"
	},
	"dependencies": {
		"@headlessui/react": "^1.7.18",
		"@prisma/client": "^6.15.0",
		"@radix-ui/react-accordion": "^1.2.0",
		"@radix-ui/react-avatar": "^1.1.1",
		"@radix-ui/react-dialog": "^1.1.1",
		"@radix-ui/react-navigation-menu": "^1.2.0",
		"@radix-ui/react-slider": "^1.2.1",
		"@radix-ui/react-slot": "^1.1.0",
		"@radix-ui/react-switch": "^1.1.1",
		"@radix-ui/react-tooltip": "^1.1.2",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"formik": "^2.4.6",
		"lucide-react": "^0.408.0",
		"next": "^14.2.31",
		"next-themes": "^0.4.4",
		"nextjs-toploader": "^1.6.11",
		"pg": "^8.16.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-hot-toast": "^2.4.1",
		"resend": "^4.0.0",
		"sass": "^1.82.0",
		"sharp": "^0.33.0",
		"stripe": "^16.0.0",
		"tailwind-merge": "^2.4.0",
		"tailwindcss-animate": "^1.0.7",
		"yup": "^1.4.0"
	},
	"devDependencies": {
		"@types/jest": "^29.5.12",
		"@types/pg": "^8.10.9",
		"@types/mdx": "^2.0.12",
		"@types/node": "^20",
		"@types/pdfkit": "^0.13.5",
		"@types/react": "^18",
		"@types/react-dom": "^18",
		"@types/react-syntax-highlighter": "^15.5.11",
		"@typescript-eslint/eslint-plugin": "^7.16.0",
		"@typescript-eslint/parser": "^7.16.0",
		"autoprefixer": "^10.4.20",
		"daisyui": "^4.10.1",
		"eslint-config-next": "^14.2.31",
		"husky": "^9.1.7",
		"postcss": "^8.4.49",
		"prisma": "^6.15.0",
		"tailwindcss": "^3.4.16",
		"tailwindcss-animate": "^1.0.7",
		"tsx": "^4.21.0",
		"typescript": "^5"
	}
}
