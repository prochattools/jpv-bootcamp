generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SYSTEM_DATABASE_URL")
  schemas           = ["public", "tenant_jpvbootcamp"]
}

model EmailSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_subscribers")
  @@schema("public")
}

model StripeWebhookEvent {
  eventId     String   @id @map("event_id")
  type        String   @default("unknown") @map("type")
  livemode    Boolean  @map("livemode")
  receivedAt  DateTime @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  payload     Json?    @map("payload")

  @@map("stripe_webhook_events")
  @@schema("tenant_jpvbootcamp")
}

model CustomerProvisioning {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  email                String
  normalizedEmail      String   @map("normalized_email")
  stripeCustomerId     String   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?  @unique @map("stripe_subscription_id")
  wpUserId             Int?     @map("wp_user_id")
  plan                 String?  @map("plan")
  currentPlan          String?  @map("current_plan")
  status               String   @default("active")
  lastEventId          String?  @map("last_event_id")
  lastNotifiedPlan     String?  @map("last_notified_plan")
  lastNotifiedAt       DateTime? @map("last_notified_at")
  lastNotifiedEventId  String?  @map("last_notified_event_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([normalizedEmail])
  @@map("customer_provisioning")
  @@schema("tenant_jpvbootcamp")
}

model Audiences {
  id        String @id
  resend_id String @unique
  name      String

  @@schema("public")
}

model Project {
  id            String   @id
  connection_id String
  webhook_id    String
  scenario_id   String
  user_clerk_id String
  type          String
  status        String   @default("default")
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  assistant_id  String?
  webhookLink   String

  @@schema("public")
}

model Subscription {
  id                 String             @id
  user_email         String             @unique
  sub_status         SubscriptionStatus @default(inactive)
  sub_type           String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  last_stripe_cs_id  String             @unique
  stripe_customer_id String             @unique
  sub_stripe_id      String?
  user_clerk_id      String             @unique

  @@schema("public")
}

enum SubscriptionStatus {
  active
  inactive

  @@schema("public")
}
