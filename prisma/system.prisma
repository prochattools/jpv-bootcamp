generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SYSTEM_DATABASE_URL")
}

model EmailSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_subscribers")
}

model StripeWebhookEvent {
  eventId     String   @id @map("event_id")
  type        String   @default("unknown") @map("type")
  livemode    Boolean  @map("livemode")
  receivedAt  DateTime @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  payload     Json?    @map("payload")

  @@map("stripe_webhook_events")
}

model CustomerProvisioning {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  email                String
  normalizedEmail      String   @map("normalized_email")
  stripeCustomerId              String    @unique @map("stripe_customer_id")
  stripeSubscriptionId          String?   @unique @map("stripe_subscription_id")
  stripeSubscriptionScheduleId  String?   @unique @map("stripe_subscription_schedule_id")
  stripeCheckoutSessionId       String?   @unique @map("stripe_checkout_session_id")
  accountId                     Int?      @map("account_id")
  plan                 String?  @map("plan")
  currentPlan          String?  @map("current_plan")
  status               String   @default("active")
  lastEventId          String?  @map("last_event_id")
  lastNotifiedPlan     String?  @map("last_notified_plan")
  lastNotifiedAt       DateTime? @map("last_notified_at")
  lastNotifiedEventId  String?  @map("last_notified_event_id")
  stripePriceId        String?  @map("stripe_price_id")
  subscriptionStatus   String?  @map("subscription_status")
  subscriptionCurrentPeriodEnd DateTime? @map("subscription_current_period_end")
  subscriptionCancelAtPeriodEnd Boolean? @map("subscription_cancel_at_period_end")
  subscriptionUpdatedAt          DateTime? @map("subscription_updated_at")
  billingCadence                  String?   @map("billing_cadence")
  commitmentStatus                String?   @map("commitment_status")
  commitmentStartAt               DateTime? @map("commitment_start_at")
  commitmentEndAt                 DateTime? @map("commitment_end_at")
  cancellationRequestedAt         DateTime? @map("cancellation_requested_at")
  cancellationEffectiveAt         DateTime? @map("cancellation_effective_at")
  paymentGraceEndsAt              DateTime? @map("payment_grace_ends_at")
  lastPaidInvoiceId               String?   @map("last_paid_invoice_id")
  lastPaymentFailureAt            DateTime? @map("last_payment_failure_at")
  contractVersion                 String?   @map("contract_version")
  contractAcceptedAt              DateTime? @map("contract_accepted_at")
  immediateAccessConsentAt        DateTime? @map("immediate_access_consent_at")
  earlyTerminationReason          String?   @map("early_termination_reason")
  earlyTerminationApprovedBy      String?   @map("early_termination_approved_by")
  paymentStatus                   String?   @map("payment_status")
  paymentFailedAt            DateTime? @map("payment_failed_at")
  paymentRecoveredAt         DateTime? @map("payment_recovered_at")
  paymentRefundedAt          DateTime? @map("payment_refunded_at")
  paymentDisputeStatus       String?   @map("payment_dispute_status")
  paymentDisputedAt          DateTime? @map("payment_disputed_at")
  paymentDisputeResolvedAt   DateTime? @map("payment_dispute_resolved_at")
  paymentUpdatedAt           DateTime? @map("payment_updated_at")
  paymentLastEventId         String?   @map("payment_last_event_id")
  paymentLastInvoiceId       String?   @map("payment_last_invoice_id")
  paymentLastChargeId        String?   @map("payment_last_charge_id")
  paymentLastPaymentIntentId String?   @map("payment_last_payment_intent_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([normalizedEmail])
  @@map("customer_provisioning")
}

model PartnerSession {
  sessionId   String   @id @map("session_id")
  accountId    Int      @map("account_id")
  accountEmailHash String   @map("account_email_hash")
  accountName      String   @map("account_name")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([accountId])
  @@index([expiresAt])
  @@map("partner_sessions")
}

model PartnerClick {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  createdAt    DateTime @default(now()) @map("created_at")
  sessionId    String   @map("session_id")
  accountId     Int      @map("account_id")
  partnerSlug  String   @map("partner_slug")
  categorySlug String   @map("category_slug")
  refPath      String?  @map("ref_path")
  userAgentHash String? @map("user_agent_hash")
  ipHash       String?  @map("ip_hash")

  @@index([sessionId])
  @@index([accountId])
  @@index([partnerSlug])
  @@index([categorySlug])
  @@index([createdAt])
  @@map("partner_clicks")
}

model SponsoredSeat {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  createdAt              DateTime @default(now()) @map("created_at")
  tier                   String   @map("tier")
  stripePaymentIntentId  String   @unique @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String  @unique @map("stripe_checkout_session_id")
  donatedByEmailHash     String?  @map("donated_by_email_hash")
  reservedByApplicationId String? @db.Uuid @map("reserved_by_application_id")
  reservedAt             DateTime? @map("reserved_at")
  donorEmailSentAt       DateTime? @map("donor_email_sent_at")
  adminNotifiedAt        DateTime? @map("admin_notified_at")
  claimedByAccountId      Int?     @map("claimed_by_account_id")
  claimedAt              DateTime? @map("claimed_at")

  grants SponsoredGrant[]

  @@index([claimedByAccountId])
  @@index([reservedByApplicationId])
  @@index([createdAt])
  @@map("sponsored_seats")
}

model SponsoredApplication {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  status             String   @map("status")
  decision           String?  @map("decision")
  decidedAt          DateTime? @map("decided_at")
  tier               String   @map("tier")
  accountId           Int?     @map("account_id")
  email              String?  @map("email")
  emailHash          String   @map("email_hash")
  name               String   @map("name")
  phone              String   @map("phone")
  message            String?  @map("message")
  lastAdminEmailSentAt DateTime? @map("last_admin_email_sent_at")
  seatId             String?  @db.Uuid @map("seat_id")
  claimTokenSentAt   DateTime? @map("claim_token_sent_at")
  claimedAt          DateTime? @map("claimed_at")
  reviewedByAccountId Int?     @map("reviewed_by_account_id")
  reviewedAt         DateTime? @map("reviewed_at")
  decisionNote       String?  @map("decision_note")

  @@index([status])
  @@index([accountId])
  @@index([email])
  @@index([seatId])
  @@map("sponsored_applications")
}

model SupportRequest {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at")
  normalizedEmail           String    @map("normalized_email")
  name                      String    @map("name")
  question                  String    @map("question")
  source                    String?   @map("source")
  page                      String?   @map("page")
  dedupeKey                 String    @unique @map("dedupe_key")
  reviewStatus              String    @default("pending") @map("review_status")
  notificationStatus        String    @default("pending") @map("notification_status")
  notificationAttemptCount  Int       @default(0) @map("notification_attempt_count")
  notificationLastAttemptAt DateTime? @map("notification_last_attempt_at")
  notificationNextAttemptAt DateTime? @map("notification_next_attempt_at")
  notificationLastErrorCode String?   @map("notification_last_error_code")
  reviewedAt                DateTime? @map("reviewed_at")
  reviewedByAccountId       Int?      @map("reviewed_by_account_id")

  @@index([normalizedEmail])
  @@index([reviewStatus])
  @@index([notificationStatus])
  @@index([createdAt])
  @@map("support_requests")
}

model SponsoredGrant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  createdAt DateTime @default(now()) @map("created_at")
  accountId  Int      @map("account_id")
  tier      String   @map("tier")
  seatId    String   @map("seat_id") @db.Uuid
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  revokedAt DateTime? @map("revoked_at")

  seat SponsoredSeat @relation(fields: [seatId], references: [id])

  @@index([accountId])
  @@index([endsAt])
  @@map("sponsored_grants")
}

model Audiences {
  id        String @id
  resend_id String @unique
  name      String

  @@map("audiences")
}

model Project {
  id            String   @id
  connection_id String
  webhook_id    String
  scenario_id   String
  user_clerk_id String
  type          String
  status        String   @default("default")
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  assistant_id  String?
  webhookLink   String
}

model Subscription {
  id                 String             @id
  user_email         String             @unique
  sub_status         SubscriptionStatus @default(inactive)
  sub_type           String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  last_stripe_cs_id  String             @unique
  stripe_customer_id String             @unique
  sub_stripe_id      String?
  user_clerk_id      String             @unique
}

enum SubscriptionStatus {
  active
  inactive
}

model EmailEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  type           String    @map("type")
  recipient      String    @map("recipient")
  payload        Json      @map("payload")
  idempotencyKey String    @unique @map("idempotency_key")
  status         String    @default("pending") @map("status")
  retryCount     Int       @default(0) @map("retry_count")
  resendId       String?   @map("resend_id")
  errorMessage   String?   @map("error_message")
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([status], name: "email_events_status_idx")
  @@index([createdAt], name: "email_events_created_at_idx")
  @@map("email_events")
}
