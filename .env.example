# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Portal upgrade URL (Fluent Community)
NEXT_PUBLIC_PORTAL_UPGRADE_URL="https://YOUR_PORTAL_DOMAIN/path-to-upgrade"

# Stripe
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PRICE_PRO="price_xxx"
NEXT_PUBLIC_STRIPE_PRICE_VIP="price_xxx"

# Stripe behavior
STRIPE_SUCCESS_URL="/billing/success"
STRIPE_CANCEL_URL="/#pricing"

# WordPress portal
WP_BASE_URL="https://portal.jpvbootcamp.com"
WP_ADMIN_USERNAME="service_user"
WP_APPLICATION_PASSWORD="xxxx xxxx xxxx xxxx"
WP_ROLE_PRO="jpv_pro"
WP_ROLE_VIP="jpv_vip"
WP_ROLE_DEFAULT="subscriber"

# Email
RESEND_API_KEY="re_..."
EMAIL_FROM="JPV Bootcamp <support@jpvbootcamp.com>"
EMAIL_REPLY_TO="support@jpvbootcamp.com"
SUPPORT_TO_EMAIL="support@jpvbootcamp.com"

# Provisioning URLs (sent to user)
PORTAL_LOGIN_URL="https://portal.jpvbootcamp.com/community/?fcom_action=auth"
PORTAL_SET_PASSWORD_URL="https://portal.jpvbootcamp.com/wp-login.php?action=lostpassword"

# Operational
WEBHOOK_IDEMPOTENCY_TTL_HOURS=168
NODE_ENV=development

# Optional: Analytics and monitoring
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="yourdomain.com"
