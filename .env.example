# Stripe mode selector
STRIPE_ENV=test

# Stripe keys and ids per mode
STRIPE_SECRET_KEY_TEST=CHANGE_ME
STRIPE_SECRET_KEY_LIVE=CHANGE_ME
STRIPE_WEBHOOK_SECRET_TEST=CHANGE_ME
STRIPE_WEBHOOK_SECRET_LIVE=CHANGE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=CHANGE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=CHANGE_ME
STRIPE_PRICE_PRO_TEST=CHANGE_ME
STRIPE_PRICE_PRO_ANNUAL_TEST=CHANGE_ME
STRIPE_PRICE_PRO_LIVE=CHANGE_ME
STRIPE_PRICE_PRO_ANNUAL_LIVE=CHANGE_ME
STRIPE_PRODUCT_JPV_BOOTCAMP_PRO_MEMBERSHIP_TEST=CHANGE_ME
STRIPE_PRODUCT_JPV_BOOTCAMP_PRO_MEMBERSHIP_LIVE=CHANGE_ME
STRIPE_PORTAL_CONFIGURATION_ID_TEST=CHANGE_ME
STRIPE_PORTAL_CONFIGURATION_ID_LIVE=CHANGE_ME

# Optional Stripe billing portal fallback
STRIPE_CUSTOMER_SEARCH_ENABLED=false

# Email gating
DISABLE_NON_WEBHOOK_EMAILS=false

# Resend (sponsored applications)
RESEND_API_KEY=CHANGE_ME
SPONSORED_MAIL_FROM=support@jpvbootcamp.com
SPONSORED_APPLICATION_ADMIN_EMAILS=admin@jpvbootcamp.com
SPONSORED_PORTAL_URL=https://portal.jpvbootcamp.com/community/
# Portal base URL for claim links
SPONSORED_PORTAL_BASE_URL=https://portal.jpvbootcamp.com
# Secret used for sponsored approval/reject email links
SPONSORED_DECISION_SECRET=CHANGE_ME
# Secret used for sponsored claim links (set in WP + Next)
SPONSORED_CLAIM_SECRET=CHANGE_ME
# Public base URL for links in emails (no localhost)
APP_BASE_URL=https://jpvbootcamp.com

# Partners handoff
PARTNERS_HANDOFF_SECRET=CHANGE_ME
PARTNERS_ADMIN_WP_USER_IDS=12345

# Sponsored seats (pay it forward)
SPONSORED_PRO_PRICE_ID_TEST=price_...
SPONSORED_VIP_PRICE_ID_TEST=price_...
SPONSORED_PRO_PRICE_ID_LIVE=price_...
SPONSORED_VIP_PRICE_ID_LIVE=price_...
SPONSORED_SEATS_SUCCESS_URL=https://jpvbootcamp.com/thank-you/sponsor?session_id={CHECKOUT_SESSION_ID}
SPONSORED_SEATS_CANCEL_URL=https://jpvbootcamp.com/pricing
SPONSORED_SEATS_ADMIN_WP_USER_IDS=12345

# Payload CMS
PAYLOAD_SECRET=CHANGE_ME_use_a_32_char_random_string
NEXT_PUBLIC_SERVER_URL=https://jpvbootcamp.com



# Preview/runtime readiness
# application-only starts the standalone app without schema initialization or migrations.
# database-deploy is opt-in and also requires an explicit DEPLOYMENT_ENV.
STARTUP_MODE=application-only
DEPLOYMENT_RUNTIME=docker
DEPLOYMENT_ENV=preview
APP_SLUG=jpv_preview
NODE_ENV=production

# Database configuration placeholders
# DATABASE_URL must include an explicit, reviewed schema parameter.
DATABASE_URL=postgresql://APP_USER:CHANGE_ME@DB_HOST:5432/DB_NAME?schema=APP_SCHEMA
SYSTEM_DATABASE_URL=postgresql://SYSTEM_USER:CHANGE_ME@DB_HOST:5432/DB_NAME

# Public application URL used for same-origin account links.
APP_PUBLIC_URL=https://preview.example.invalid

# Queued account-security email sender
# Apply mode requires an approved sender identity plus RESEND_API_KEY.
# Dry-run still initializes Payload and therefore requires authorized database access.
# Account-security email uses payload_email_events; the legacy welcome helper is separate.
RESEND_FROM="JPV Bootcamp <verified-sender@example.invalid>"
EMAIL_REPLY_TO=reply-to@example.invalid
